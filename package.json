{
  "name": "booka",
  "version": "0.1.0",
  "private": true,
  "description": "Spoiler-safe, progress-aware book club discussion (MVP prototype).",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "run-p --print-label dev:server dev:client",
    "dev:server": "npm run dev -w backend",
    "dev:client": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "node backend/dist/server.js",
    "test": "npm run test -w frontend && npm run test -w backend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx prisma/verify.ts"
  },
  "dependencies": {
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
