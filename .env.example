# Copy to .env (never commit .env or a real DATABASE_URL).

# demo -> fixtures served by /api/demo, progress + new posts saved in the browser (localStorage)
# db   -> club, book, checkpoints, members, threads and posts loaded/saved through Express + Prisma
DATA_SOURCE=demo

# Required for DATA_SOURCE=db, the db:* scripts and GET /api/health/db.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/booka_dev?schema=public"

# Port for the Express server (Render provides this automatically).
PORT=3000
