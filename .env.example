# Copy to .env (never commit .env or a real DATABASE_URL).

# PostgreSQL connection string. Required: the server, db:* scripts and seed use it.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/booka_dev?schema=public"

# Optional: password given to the seeded demo accounts (maya@, jordan@,
# riley@example.com) by `npm run db:seed`. Leave unset in production unless
# you want those demo accounts to be able to sign in.
DEMO_PASSWORD=

# Optional: a SEPARATE, disposable database for the API integration tests.
# The tests wipe it before every run. Never point this at real data.
TEST_DATABASE_URL=

# Optional: Express port (Render provides this automatically).
PORT=3000

# Optional: days a sign-in stays valid (default 30).
SESSION_TTL_DAYS=30

# In production set NODE_ENV=production at runtime so session cookies are
# HTTPS-only (Secure).
